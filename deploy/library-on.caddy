# GLISSANDO_DATA_DIR set: the library service on loopback answers /api/library (ADR-0018).
@library path /api/library /api/library/*
handle @library {
	reverse_proxy 127.0.0.1:{$GLISSANDO_LIBRARY_PORT}
}

# Share links: public, no sign-in (ADR-0025, dev-docs/SHARE_LINK.md). The token is in the path,
# so no page or answer here hands it on as a Referer. The service's /internal/ paths are never
# routed: the picture check below asks it on loopback.
@sharePicture path_regexp sharePicture ^/api/share/([^/]+)/[0-9]+/pictures/([0-9]+)$
handle @sharePicture {
	log_name share
	header Referrer-Policy no-referrer
	# Deferred to the response, after Caddy's own.
	header -Server
	header -Via
	# In this order: the check names the asset the rewrite fetches.
	route {
		# A non-2xx answer (notShared, noSuchPicture) goes to the client as it is.
		forward_auth 127.0.0.1:{$GLISSANDO_LIBRARY_PORT} {
			uri /internal/share-picture/{re.sharePicture.1}/{re.sharePicture.2}
			copy_headers X-Glissando-Immich-Asset
		}
		# The query is replaced whole, so no credential a client adds reaches Immich.
		rewrite * /api/assets/{http.request.header.X-Glissando-Immich-Asset}/thumbnail?size=preview
		reverse_proxy {$IMMICH_URL} {
			header_up -Authorization
			header_up -Cookie
			header_up -X-Immich-*
			header_up -X-Glissando-Immich-Asset
			header_up X-Api-Key {env.GLISSANDO_IMMICH_API_KEY}
			# Only the picture's own headers reach the recipient, nothing about Immich: every
			# header is dropped, then the allowed ones are set again.
			header_down -*
			# Immich answers a preview with both; a placeholder of a header that is missing
			# would be sent as its literal text.
			@sizedPreview {
				status 2xx
				header Content-Length *
				header Etag *
			}
			handle_response @sizedPreview {
				header Content-Type {rp.header.Content-Type}
				header Content-Length {rp.header.Content-Length}
				header Etag {rp.header.Etag}
				header Cache-Control "private, max-age=86400"
				copy_response
			}
			@preview status 2xx
			handle_response @preview {
				header Content-Type {rp.header.Content-Type}
				header Cache-Control "private, max-age=86400"
				copy_response
			}
			handle_response {
				respond "" {rp.status_code}
			}
		}
	}
}

@shareApi path /api/share/*
handle @shareApi {
	log_name share
	header Referrer-Policy no-referrer
	reverse_proxy 127.0.0.1:{$GLISSANDO_LIBRARY_PORT}
}

# The recipient's page: the same file for every token, which it reads from its own path.
@sharePage path /s/*
handle @sharePage {
	log_name share
	header Referrer-Policy no-referrer
	header Cache-Control no-cache
	root * /srv
	rewrite * /share.html
	file_server
}
