# GLISSANDO_DATA_DIR set: the library service on loopback answers /api/library (ADR-0018).
# The TV remote's claim and show (dev-docs/tv_remote/HTTP_API.md) carry a remote's secret in the
# path, so they log through the share logger, which redacts it.
@libraryTv path /api/library/tv/*
handle @libraryTv {
	log_name share
	reverse_proxy 127.0.0.1:{$GLISSANDO_LIBRARY_PORT}
}

@library path /api/library /api/library/*
handle @library {
	reverse_proxy 127.0.0.1:{$GLISSANDO_LIBRARY_PORT}
}

# Share links: public, no sign-in (ADR-0025, dev-docs/SHARE_LINK.md). The token is in the path,
# so no page or answer here hands it on as a Referer. The service's /internal/ paths are never
# routed: the picture check below asks it on loopback. Only GET and HEAD of a path of the exact
# shape, with a token of 22 base64url characters, reach a share route; any other request under
# /api/share/ or /s/ answers 404 here.
@sharePicture {
	method GET HEAD
	path_regexp sharePicture ^/api/share/([A-Za-z0-9_-]{22})/[0-9]+/pictures/([0-9]+)$
}
handle @sharePicture {
	import immich_preview /internal/share-picture/{re.sharePicture.1}/{re.sharePicture.2}
}

@shareApi {
	method GET HEAD
	path_regexp ^/api/share/[A-Za-z0-9_-]{22}(/songs/[0-9]+)?$
}
handle @shareApi {
	log_name share
	header Referrer-Policy no-referrer
	reverse_proxy 127.0.0.1:{$GLISSANDO_LIBRARY_PORT}
}

# The recipient's page: the same file for every token, which it reads from its own path.
@sharePage {
	method GET HEAD
	path_regexp ^/s/[A-Za-z0-9_-]{22}$
}
handle @sharePage {
	log_name share
	header Referrer-Policy no-referrer
	header Cache-Control no-cache
	root * /srv
	rewrite * /share.html
	file_server
}

# The TV remote: public, no sign-in (ADR-0031, dev-docs/tv_remote/HTTP_API.md). A TV's key and a
# remote's secret are 22 base64url characters in the path, like a share token; only the exact
# shapes and methods below reach the service, and any other request under /api/tv/, /tv or /r/
# answers 404 here. A way B session is made under /api/share/, so it comes before shareOther.
@tvPicture {
	method GET HEAD
	path_regexp tvPicture ^/api/tv/([A-Za-z0-9_-]{22})/show/[0-9]+/pictures/([0-9]+)$
}
handle @tvPicture {
	import immich_preview /internal/tv-picture/{re.tvPicture.1}/{re.tvPicture.2}
}

# The two streams: every event is passed on as it comes, never buffered.
@tvStream {
	method GET
	path_regexp ^/api/tv/(remote/)?[A-Za-z0-9_-]{22}/events$
}
handle @tvStream {
	log_name share
	header Referrer-Policy no-referrer
	reverse_proxy 127.0.0.1:{$GLISSANDO_LIBRARY_PORT} {
		flush_interval -1
	}
}

@tvRead {
	method GET HEAD
	path_regexp ^/api/tv/[A-Za-z0-9_-]{22}/show(/songs/[0-9]+)?$
}
handle @tvRead {
	log_name share
	header Referrer-Policy no-referrer
	reverse_proxy 127.0.0.1:{$GLISSANDO_LIBRARY_PORT}
}

@tvPost {
	method POST
	path_regexp ^/api/(tv/sessions|tv/remote/[A-Za-z0-9_-]{22}/command|share/[A-Za-z0-9_-]{22}/tv)$
}
handle @tvPost {
	log_name share
	header Referrer-Policy no-referrer
	reverse_proxy 127.0.0.1:{$GLISSANDO_LIBRARY_PORT}
}

@tvPut {
	method PUT
	path_regexp ^/api/tv/[A-Za-z0-9_-]{22}/state$
}
handle @tvPut {
	log_name share
	header Referrer-Policy no-referrer
	reverse_proxy 127.0.0.1:{$GLISSANDO_LIBRARY_PORT}
}

# The TV's page is the recipient's page (dev-docs/tv_remote/TV_PAGE.md); the remote's page reads
# its secret from its own path.
@tvPage {
	method GET HEAD
	path /tv
}
handle @tvPage {
	log_name share
	header Referrer-Policy no-referrer
	header Cache-Control no-cache
	root * /srv
	rewrite * /share.html
	file_server
}

@remotePage {
	method GET HEAD
	path_regexp ^/r/[A-Za-z0-9_-]{22}$
}
handle @remotePage {
	log_name share
	header Referrer-Policy no-referrer
	header Cache-Control no-cache
	root * /srv
	rewrite * /remote.html
	file_server
}

@tvOther path /api/tv /api/tv/* /tv /tv/* /r /r/*
handle @tvOther {
	log_name share
	respond 404
}

@shareOther path /api/share/* /s/*
handle @shareOther {
	log_name share
	respond 404
}
