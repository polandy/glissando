# No GLISSANDO_DATA_DIR: the app reads a 404 as "no slideshows on the server" (ADR-0018).
@library path /api/library /api/library/*
handle @library {
	respond 404
}

# Without slideshows on the server, nothing is shared by link (ADR-0025).
@share path /api/share/* /s/*
handle @share {
	log_name share
	respond 404
}
