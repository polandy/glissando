# Only the reads Glissando makes reach Immich, with the server's key; the rest answers 403
# (ADR-0013). The patterns are anchored, so an encoded or dotted path matches none of them.
@immichAllowed expression `(method('GET') && path_regexp('^/immich/api/(server/version|albums|faces|assets/[0-9a-fA-F-]{36}/(thumbnail|original))$')) || (method('POST') && path('/immich/api/search/metadata'))`

handle @immichAllowed {
	uri strip_prefix /immich
	# Immich also takes credentials from the query; only the server's key may sign a request.
	uri query {
		-apiKey
		-key
		-slug
		-sessionKey
	}
	reverse_proxy {$IMMICH_URL} {
		header_up -Authorization
		header_up -Cookie
		header_up -X-Immich-*
		header_up X-Api-Key {env.GLISSANDO_IMMICH_API_KEY}
		header_down -Set-Cookie
	}
}

handle /immich/* {
	respond 403
}
