# Started by entrypoint.sh, which validates the environment and chooses the Immich and library
# routes.

# The credentials a client may send, in headers or in the query (see immich-proxy.caddy); no log
# keeps them, the access log nor the error log of a failed request.
(credential_log_filters) {
	format filter {
		wrap json
		fields {
			request>headers>X-Api-Key delete
			request>headers>Cookie delete
			request>headers>Authorization delete
			request>headers>X-Immich-Share-Key delete
			request>uri query {
				delete apiKey
				delete key
				delete slug
				delete sessionKey
			}
		}
	}
}

# A share link's token is a secret (dev-docs/share_link/HTTP_API.md, Logs), and so are a TV's key
# and a remote's secret (dev-docs/tv_remote/HTTP_API.md): the share and TV routes (log_name share)
# log their requests and errors with each replaced by … and without the query, which those routes
# never use. Under /api/tv/ and /api/library/tv/ a segment shorter than any key or secret is a
# route's name (sessions, remote, claim) and stays.
(share_log_filters) {
	format filter {
		wrap json
		fields {
			request>headers>Cookie delete
			request>headers>Authorization delete
			request>headers>X-Api-Key delete
			request>headers>X-Immich-Share-Key delete
			request>headers>Referer delete
			request>uri multi_regexp {
				regexp (?i)^(/api/share/|/s/|/internal/share-picture/|/internal/tv-picture/|/r/|/api/tv/remote/)[^/?]* "${1}…"
				regexp (?i)^(/api/tv/)[^/?]{9,} "${1}…"
				regexp (?i)^(/api/library/tv/)[^/?]{6,} "${1}…"
				regexp \?.*$ ""
			}
		}
	}
}

# A shared picture: the library service names its Immich asset (forward_auth to the check at
# args[0]), and Caddy fetches the preview with the server's key (ADR-0025). Used for share links
# and for a TV's session (library-on.caddy).
(immich_preview) {
	log_name share
	header Referrer-Policy no-referrer
	# Deferred to the response, after Caddy's own.
	header -Server
	header -Via
	# In this order: the check names the asset the rewrite fetches.
	route {
		# A non-2xx answer (notShared, notShown, noSuchPicture) goes to the client as it is.
		forward_auth 127.0.0.1:{$GLISSANDO_LIBRARY_PORT} {
			uri {args[0]}
			copy_headers X-Glissando-Immich-Asset
		}
		# The query is replaced whole, so no credential a client adds reaches Immich.
		rewrite * /api/assets/{http.request.header.X-Glissando-Immich-Asset}/thumbnail?size=preview
		reverse_proxy {$IMMICH_URL} {
			header_up -Authorization
			header_up -Cookie
			header_up -X-Immich-*
			header_up -X-Glissando-Immich-Asset
			header_up X-Api-Key {env.GLISSANDO_IMMICH_API_KEY}
			# Only the picture's own headers reach the recipient, nothing about Immich: every
			# header is dropped, then the allowed ones are set again.
			header_down -*
			# Immich answers a preview with both; a placeholder of a header that is missing
			# would be sent as its literal text.
			@sizedPreview {
				status 2xx
				header Content-Length *
				header Etag *
			}
			handle_response @sizedPreview {
				header Content-Type {rp.header.Content-Type}
				header Content-Length {rp.header.Content-Length}
				header Etag {rp.header.Etag}
				header Cache-Control "private, max-age=86400"
				copy_response
			}
			@preview status 2xx
			handle_response @preview {
				header Content-Type {rp.header.Content-Type}
				header Cache-Control "private, max-age=86400"
				copy_response
			}
			handle_response {
				respond "" {rp.status_code}
			}
		}
	}
}

{
	admin off
	persist_config off
	auto_https off
	log {
		output stdout
		import credential_log_filters
		exclude http.log.error.share
	}
	log share_errors {
		output stdout
		import share_log_filters
		include http.log.error.share
	}
}

# Plain HTTP: TLS and access protection come from the owner's reverse proxy.
:8080 {
	log {
		output stdout
		import credential_log_filters
	}
	log share {
		output stdout
		import share_log_filters
	}

	# A share or TV path whose raw URI holds an escape or a dot segment could, once Caddy unescaped
	# and cleaned it, match another route than the public path the owner's sign-in let through: it
	# is sent to a path that answers 404 before any route sees it.
	@shareEscape vars_regexp {http.request.uri} (?i)^/(s|r|tv|api/share|api/tv)/.*(%|\.\.)
	rewrite @shareEscape /internal/share-escape

	# immich-proxy.caddy or immich-off.caddy.
	import {$GLISSANDO_IMMICH_ROUTE}
	# library-on.caddy or library-off.caddy.
	import {$GLISSANDO_LIBRARY_ROUTE}

	# The library service's own paths, asked on loopback only; their logs carry no token.
	handle /internal/* {
		log_name share
		respond 404
	}

	handle {
		root * /srv
		file_server
	}
}
