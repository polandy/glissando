# Started by entrypoint.sh, which validates the environment and chooses the Immich and library
# routes.

# The credentials a client may send, in headers or in the query (see immich-proxy.caddy); no log
# keeps them, the access log nor the error log of a failed request.
(credential_log_filters) {
	format filter {
		wrap json
		fields {
			request>headers>X-Api-Key delete
			request>headers>Cookie delete
			request>headers>Authorization delete
			request>headers>X-Immich-Share-Key delete
			request>uri query {
				delete apiKey
				delete key
				delete slug
				delete sessionKey
			}
		}
	}
}

# A share link's token is a secret (dev-docs/SHARE_LINK.md, Logs): the share routes (log_name
# share) log their requests and errors with the token replaced by … and without the query, which
# those routes never use.
(share_log_filters) {
	format filter {
		wrap json
		fields {
			request>headers>Cookie delete
			request>headers>Authorization delete
			request>headers>X-Api-Key delete
			request>headers>X-Immich-Share-Key delete
			request>headers>Referer delete
			request>uri multi_regexp {
				regexp ^(/api/share/|/s/|/internal/share-picture/)[^/?]* "${1}…"
				regexp \?.*$ ""
			}
		}
	}
}

{
	admin off
	persist_config off
	auto_https off
	log {
		output stdout
		import credential_log_filters
		exclude http.log.error.share
	}
	log share_errors {
		output stdout
		import share_log_filters
		include http.log.error.share
	}
}

# Plain HTTP: TLS and access protection come from the owner's reverse proxy.
:8080 {
	log {
		output stdout
		import credential_log_filters
	}
	log share {
		output stdout
		import share_log_filters
	}

	# immich-proxy.caddy or immich-off.caddy.
	import {$GLISSANDO_IMMICH_ROUTE}
	# library-on.caddy or library-off.caddy.
	import {$GLISSANDO_LIBRARY_ROUTE}

	# The library service's own paths, asked on loopback only; their logs carry no token.
	handle /internal/* {
		log_name share
		respond 404
	}

	handle {
		root * /srv
		file_server
	}
}
